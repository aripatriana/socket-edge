<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/JGroups-5.0.xsd">

    <TCP bind_addr="${jgroups.bind_addr}"
         bind_port="7800"
         port_range="5"
         recv_buf_size="25M"
         send_buf_size="25M"
         max_bundle_size="64K"
         enable_diagnostics="false"/>

    <TCPPING timeout="3000"
             initial_hosts="${jgroups.members}"
             port_range="5"/>

    <FD_SOCK/>
    <FD_ALL timeout="6000" interval="2000"/>
    <VERIFY_SUSPECT timeout="2000"/>

    <NAKACK2 use_mcast_xmit="false"
             xmit_interval="300"
             xmit_table_num_rows="200"
             xmit_table_msgs_per_row="2000"/>

    <UNICAST3/>
    <STABLE stability_delay="1000" desired_avg_gossip="15000"/>

    <GMS print_local_addr="true"
         join_timeout="4000"
         view_bundling="true"/>

    <UFC max_credits="15M" min_threshold="0.3"/>
    <MFC max_credits="15M" min_threshold="0.3"/>

    <FRAG2 frag_size="60K"/>
</config>
